# frontend (Next.js) — see CONTRACTS.md section 2.
#
# Two base URLs on purpose:
#  - API_BASE_URL is used by Server Components, which run inside the `frontend`
#    container and must reach the backend by its compose service name.
#  - NEXT_PUBLIC_API_BASE_URL is used by browser code (polling), which resolves
#    against the published host port, not the compose network.

API_BASE_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

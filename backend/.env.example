APP_NAME="Scraper Trial"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# FrankenPHP listen address (plain HTTP on an unprivileged port).
SERVER_NAME=:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (CONTRACTS.md section 2) ---
# DB_HOST / DB_PORT are the compose service name and *container* port, not the
# published host port (which is 3307).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=scraper
DB_USERNAME=scraper
DB_PASSWORD=scraper

# --- Queue (CONTRACTS.md section 2) ---
# database driver so there is no Redis container.
QUEUE_CONNECTION=database

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# --- Proxy manager (CONTRACTS.md section 2) ---
PROXY_SERVICE_URL=http://proxy:8080

# --- Scraper (CONTRACTS.md section 2) ---
# fixture mode so a clean clone produces products on first run.
SCRAPER_MODE=fixture
SCRAPER_CONNECT_TIMEOUT=15
SCRAPER_READ_TIMEOUT=15
SCRAPER_MAX_RETRIES=2
SCRAPER_MAX_REDIRECTS=3
SCRAPER_THROTTLE_MS=2000
